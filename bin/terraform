#!/bin/bash
set -euo pipefail

VERSION=1.12.2
CHECKSUM=1eaed12ca41fcfe094da3d76a7e9aa0639ad3409c43be0103ee9f5a1ff4b7437
DESTDIR="$(git rev-parse --show-toplevel)/.cache/terraform/$VERSION"
EXE="$DESTDIR/bin/terraform"

if [[ ! -x "$EXE" ]]; then
    set -x

    tmpdir="$(mktemp --directory)"
    pushd "$tmpdir"

    # https://developer.hashicorp.com/terraform/tutorials/aws-get-started/install-cli#install-terraform
    curl "https://releases.hashicorp.com/terraform/$VERSION/terraform_${VERSION}_linux_amd64.zip" -o terraform.zip
    echo "$CHECKSUM  terraform.zip" \
        | sha256sum --check

    unzip -q terraform.zip

    mkdir -p "$DESTDIR/bin"
    mv terraform "$EXE"

    popd
    rm -rf "$tmpdir"

    set +x
fi

export AWS_CONFIG_FILE="$HOME/.aws/murp.us.config"
export AWS_SHARED_CREDENTIALS_FILE="$HOME/.aws/murp.us.credentials"

exec "$EXE" "$@"
